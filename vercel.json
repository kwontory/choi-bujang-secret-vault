{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/my/notes",
      "destination": "/api/my-notes"
    },
    {
      "source": "/api/notes/:id",
      "destination": "/api/notes?id=:id"
    },
    {
      "source": "/api/announcements/:id",
      "destination": "/api/announcements?id=:id"
    },
    {
      "source": "/api/admin/announcements/:id",
      "destination": "/api/admin/announcements?id=:id"
    },
    {
      "source": "/api/materials/:id",
      "destination": "/api/materials?id=:id"
    },
    {
      "source": "/api/restore/notes/:id",
      "destination": "/api/restore?id=:id"
    },
    {
      "source": "/api/admin/devices/:id",
      "destination": "/api/admin/devices?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    }
  ]
}
