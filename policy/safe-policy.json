{
  "schema": "aleph.safe-policy.v1",
  "version": "stage11-global-guard",
  "verifiedAt": "2026-10-13T12:32:41.150Z",
  "note": "10단계까지 심판 통과(100점)를 확인한 규칙에 11단계 기기 승인 규칙을 더해 로컬 시험으로 검증한 안전 정책 사본입니다. 직접 고치지 않습니다.",
  "rules": [
    {
      "id": "starter.deny",
      "layer": "decider",
      "effect": "deny",
      "target": "구역표에 없는 서비스·경로"
    },
    {
      "id": "device_registered",
      "layer": "decider",
      "effect": "deny",
      "target": "미등록 기기·기기 ID 형식 오류",
      "reasonCode": "device_not_registered"
    },
    {
      "id": "step_up_required",
      "layer": "decider",
      "effect": "step_up",
      "target": "낯선 지역·시각·네트워크·대량 행동, 출처 불명 접속 정보",
      "reasonCode": "step_up_required"
    },
    {
      "id": "zone_notes_item_only",
      "layer": "decider",
      "effect": "allow_only",
      "service": "notes",
      "allow": [
        "GET /notes/:id",
        "PUT /notes/:id",
        "DELETE /notes/:id"
      ],
      "deny": [
        "GET /notes",
        "POST /notes"
      ],
      "reasonCode": "note_list_denied"
    },
    {
      "id": "zone_announcements_read_only",
      "layer": "decider",
      "effect": "allow_only",
      "service": "announcements",
      "allow": [
        "GET /announcements",
        "GET /announcements/:id"
      ],
      "deny": [
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "reasonCode": "announcement_write_denied"
    },
    {
      "id": "zone_instructor_materials_closed",
      "layer": "decider",
      "effect": "deny",
      "service": "materials",
      "reasonCode": "instructor_material_denied"
    },
    {
      "id": "api.notes.owner_only",
      "layer": "api",
      "effect": "deny",
      "target": "검증된 사용자와 저장된 owner_id 가 다른 메모 조회·수정·삭제·복구",
      "status": 404
    },
    {
      "id": "api.login_required",
      "layer": "api",
      "effect": "deny",
      "target": "토큰 없는 자료 API 요청",
      "status": 401
    },
    {
      "id": "db.notes.anon_revoked",
      "layer": "database",
      "effect": "deny",
      "target": "공개 키(anon)로 notes 표 직접 읽기",
      "source": "supabase/step4-policy.sql"
    },
    {
      "id": "request_integrity",
      "layer": "decider",
      "effect": "deny",
      "target": "메서드·경로 모양·실제 경로가 서로 맞지 않는 요청(서명 뒤 경로·메서드 변경)",
      "reasonCode": "request_tampered"
    },
    {
      "id": "api.device_signature",
      "layer": "api",
      "effect": "deny",
      "target": "접속 앱 서명이 맞지 않거나 승인되지 않은 기기의 서명 요청",
      "status": 401
    },
    {
      "id": "zone_my_notes_owner_list",
      "layer": "decider",
      "effect": "allow_only",
      "service": "my_notes",
      "allow": [
        "GET /my/notes"
      ]
    },
    {
      "id": "zone_restore_verified_backup",
      "layer": "decider",
      "effect": "allow_only",
      "service": "restore",
      "allow": [
        "POST /restore/notes/:id"
      ]
    },
    {
      "id": "zone_device_approval",
      "layer": "decider",
      "effect": "allow_only",
      "service": "device",
      "allow": [
        "POST /device/register",
        "POST /device/status"
      ]
    },
    {
      "id": "api.global_guard",
      "layer": "api",
      "effect": "deny",
      "target": "앱 서명·서버 승인 기기 확인 뒤 판정기가 허용하지 않은 보호 요청",
      "status": 403
    }
  ],
  "rulesSha256": "6cc281cdbd463a9f70379b2b860475cd3d97554a671480def09c7cb087fc5c88"
}
